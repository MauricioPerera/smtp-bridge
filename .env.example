# SMTP to Webhook Bridge Configuration
# Copy this file to .env and update the values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Cloudflare Worker URL (required)
# This is the URL of your deployed Cloudflare Worker
WEBHOOK_URL=https://your-worker-name.your-subdomain.workers.dev

# API Key for the Cloudflare Worker (required)
# Generate with: openssl rand -hex 32
# This must match the API_KEY secret in your Cloudflare Worker
WEBHOOK_API_KEY=your-api-key-here

# =============================================================================
# SMTP SERVER SETTINGS
# =============================================================================

# Port to listen on (default: 2525)
SMTP_PORT=2525

# Host to bind to
# Use 127.0.0.1 for local-only access
# Use 0.0.0.0 to allow Docker containers to connect
SMTP_HOST=127.0.0.1

# Default sender name when not specified in email
DEFAULT_FROM_NAME=System

# =============================================================================
# RATE LIMITING
# =============================================================================

# Maximum emails per day (default: 200)
# Cloudflare free tier allows 200 emails/day
# Increase this if you have a paid Cloudflare plan
RATE_LIMIT_PER_DAY=200

# =============================================================================
# QUEUE & RETRIES (requires better-sqlite3)
# =============================================================================

# Enable SQLite queue for reliability (default: true)
# Set to false to send emails immediately without queue
ENABLE_QUEUE=true

# Maximum retry attempts for failed emails (default: 3)
MAX_RETRIES=3

# Delay between retries in milliseconds (default: 60000 = 1 minute)
RETRY_DELAY_MS=60000

# =============================================================================
# HEALTH CHECK
# =============================================================================

# Port for health check HTTP server (default: 2526)
# Endpoints: /health, /stats, /ready, /live
HEALTH_PORT=2526

# =============================================================================
# ATTACHMENTS
# =============================================================================

# Maximum attachment size in bytes (default: 25MB)
# Cloudflare Email Routing limit is 25MB per email
MAX_ATTACHMENT_SIZE=26214400
